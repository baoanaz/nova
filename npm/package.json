{
  "name": "nova-client",
  "version": "0.0.8",
  "description": "MCP stdio client for nova: local codebase sync proxy backed by a remote nova-service",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baoanaz/nova.git"
  },
  "bugs": {
    "url": "https://github.com/baoanaz/nova/issues"
  },
  "homepage": "https://github.com/baoanaz/nova#readme",
  "keywords": [
    "mcp",
    "codebase",
    "indexing",
    "context",
    "rust",
    "stdio"
  ],
  "bin": {
    "nova-client": "run.js"
  },
  "files": [
    "run.js",
    "README.md"
