# New VPS: AMD EPYC 7282, 2 vCPU, 1.9 GiB RAM; local measurements in benches/results/.
# No IP address, hostname, data path or credentials in public profiles.
# Baseline settings are frozen for hardware comparisons; full/TTFB measured, no production tuning.
EMBED_MODE=api
EMBED_MODEL=voyage-4-lite
EMBED_BASE_URL=https://api.voyageai.com
EMBED_DIM=1024
EMBED_BATCH_SIZE=500
EMBED_CONCURRENCY=4
EMBED_BATCH_TOKEN_BUDGET=300000
EMBED_MAX_INPUT_TOKENS=32000
ZACE_EMBED_WORKERS=2
# Probe cgroup: MemoryHigh=1200M, MemoryMax=1500M, MemorySwapMax=512M.
