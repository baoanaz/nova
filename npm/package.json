    "arm64"
  ],
  "optionalDependencies": {
    "nova-client-linux-x64": "0.0.8",
    "nova-client-linux-arm64": "0.0.8",
    "nova-client-darwin-x64": "0.0.8",
    "nova-client-darwin-arm64": "0.0.8",
    "nova-client-windows-x64": "0.0.8",
    "nova-client-windows-arm64": "0.0.8"
  }
}
