# Source from the repository root: set -a; source .env; set +a
# Copy this file to .env; .env and .local/ are ignored by Git.
# Installation: ENVIRONMENT.txt. Credentials: docs/handbook/privacy/资产清单.md.
NOVA_REPO_ROOT="${NOVA_REPO_ROOT:-$(pwd)}"
NOVA_DATA_ROOT="$NOVA_REPO_ROOT/.local/data"
UV_CACHE_DIR="$NOVA_REPO_ROOT/.local/cache/uv"
npm_config_cache="$NOVA_REPO_ROOT/.local/cache/npm"
HF_HOME="$NOVA_REPO_ROOT/.local/cache/huggingface"
CARGO_HOME="$NOVA_REPO_ROOT/.local/cargo"
RUSTUP_HOME="$NOVA_REPO_ROOT/.local/rustup"
PATH="$CARGO_HOME/bin:$PATH"

# TASK-115 hardware comparison: 1024 dimensions, batches of 500, concurrency 4, K=2.
# Ordinary API indexing requires a vendor-issued key in NOVA_SECRETS_FILE.
# local-only benchmarks replace network requests and need no key.
EMBED_MODE=api
EMBED_MODEL=voyage-4-lite
EMBED_BASE_URL=https://api.voyageai.com
EMBED_DIM=1024
EMBED_BATCH_SIZE=500
EMBED_CONCURRENCY=4
EMBED_BATCH_TOKEN_BUDGET=300000
EMBED_MAX_INPUT_TOKENS=32000
NOVA_EMBED_WORKERS=2

# Optional LLM summary. Configure URL/model here or in the external secrets file.
# With any required ANSWER_* value missing, ask_project returns its degraded response.
ANSWER_BASE_URL=
ANSWER_MODEL=
ANSWER_PROTOCOL=openai

# Override the deployment's administrator name explicitly.
NOVA_ADMIN_NAME=admin
NOVA_COOKIE_SECURE=false
NO_PROXY=127.0.0.1,localhost
no_proxy=127.0.0.1,localhost
NOVA_LOG_MAX_BYTES=8388608
NOVA_LOG_BACKUP_COUNT=9
NOVA_LOG_RETENTION_DAYS=14

# Private values stay outside the repository. Non-root developers use their own HOME.
NOVA_SECRETS_FILE="${NOVA_SECRETS_FILE:-$HOME/.key/nova/secrets.env}"
if [ -r "$NOVA_SECRETS_FILE" ]; then
    . "$NOVA_SECRETS_FILE"
fi
