# Historical planning profile: 2 vCPU / 2 GiB / nominal 200 Mbps.
# Not measured. Do not treat the old 22-28s estimate or a TPM-derived value as a guarantee.
# The current VPS uses epyc-2c2g.env; reports identify machines by specifications, not IP.
# Load .env for private credentials and local data paths before this optional profile.
EMBED_MODE=api
EMBED_MODEL=voyage-4-lite
EMBED_BASE_URL=https://api.voyageai.com
EMBED_DIM=1024
EMBED_BATCH_SIZE=500
EMBED_CONCURRENCY=4
EMBED_BATCH_TOKEN_BUDGET=300000
EMBED_MAX_INPUT_TOKENS=32000
NOVA_EMBED_WORKERS=2
# Proposed probe limits: MemoryHigh=1200M, MemoryMax=1500M, MemorySwapMax=512M.
# Requires measurement before any production tuning decision.
