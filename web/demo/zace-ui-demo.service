[Unit]
Description=zace UI demo API (synthetic data only)
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/zace-ui-demo
LoadCredential=auth.json:/etc/zace-ui-demo/auth.json
ExecStart=/usr/bin/node /opt/zace-ui-demo/server.mjs
Environment=PORT=8789
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
