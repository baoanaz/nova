# 硬件档案：历史 Xeon VPS（2026-09-26 复核）
#
# 设备：2 vCPU Intel Xeon E5-2680v4 @2.4GHz / 1.9 GiB / 出口实测单流 11.21、4 流 11.64 MB/s（≈90Mbps）
# 取值来源：/etc/nova/nova.env 的「2026-09-15 冻结批参数」+ TASK-115 的消费者默认值
# 证据：benches/results/{baseline-v1,index-cost-model-vps,index-perf-task114-vps,index-perf-task115-vps}.md
# 本文件只放非密钥调优项；凭据留在 $HOME/.key/nova/secrets.env（0600）。
#
# 用法：set -a; source .env; source configs/profiles/vps-xeon-2c2g.env; set +a

# ---- embedding 提供方（非密钥部分；密钥在 /etc）
EMBED_MODE=api
EMBED_MODEL=voyage-4-lite
EMBED_BASE_URL=https://api.voyageai.com
EMBED_DIM=1024

# ---- 批参数：窗口 = 500 × 4 = 2000 chunk
# 不显式设并发会回落厂商档 8 → 窗口翻倍到 4000，这台 1.9GiB 机器实测触发回收、7 分钟跑不完。
EMBED_BATCH_SIZE=500
EMBED_CONCURRENCY=4
EMBED_BATCH_TOKEN_BUDGET=300000
EMBED_MAX_INPUT_TOKENS=32000

# ---- 向量阶段消费者（TASK-115）：2 个 → 最多 8 个请求在飞，网络与解码/落库重叠
# 实测（langchain 真实 API）：K=1 79.5s/748MB → K=2 63.3s/823MB
# 设 1 即退回 TASK-114 的单消费者行为（做对照实验用）
NOVA_EMBED_WORKERS=2

# ---- systemd 内存护栏（写在 unit 文件里，此处留档）
# MemoryHigh=800M / MemoryMax=1400M
# K=2 的实测峰值 823MB < MemoryMax，安全；若要试 K=3，先把 MemoryMax 抬到 1600M。
